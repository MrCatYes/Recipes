DATABASE_URL="postgresql://epicerie:epicerie_dev@localhost:5432/epicerie"
REDIS_URL="redis://localhost:6379"
PORT=3000
NODE_ENV=development

# Groq API (Phase 2 — recipe parser fallback)
GROQ_API_KEY="your-groq-api-key-here"

# Auth (Phase P1). Generate a strong secret: openssl rand -hex 32
JWT_SECRET="change-me-min-32-chars-random-hex"
ACCESS_TOKEN_TTL="15m"

# Scraper config (Phase 3)
SCRAPER_USER_AGENT="Mozilla/5.0 (compatible; EpicerieBot/1.0)"
SCRAPER_CONCURRENCY=2
SCRAPER_DELAY_MS=2000
