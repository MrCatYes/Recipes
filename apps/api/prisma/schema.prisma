generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum StoreChain {
  IGA
  Metro
  Maxi
  Walmart
  Costco
  SuperC
}

enum UnitType {
  weight
  volume
  count
}

enum PriceSource {
  scrape
  flyer
  manual
}

// ─── Users & Auth ───────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  // Location preferences (for nearby-store geoloc)
  latitude     Float?
  longitude    Float?
  postalCode   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  shoppingLists ShoppingList[]
  mealPlans     MealPlan[]

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 of the opaque refresh token
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// ─── Shopping Lists (P2) ──────────────────────────────────────────────────────

model ShoppingList {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Ma liste")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ShoppingListItem[]

  @@index([userId])
}

model ShoppingListItem {
  id          String   @id @default(cuid())
  listId      String
  productId   String?  // curated product → enables price/cost
  rawText     String   // display text, always set
  quantity    Float?
  unit        String?
  category    String?  // aisle grouping
  checked     Boolean  @default(false)
  recipeId    String?  // provenance: added from this recipe
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  list        ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([listId])
  @@index([productId])
}

// ─── Meal Planning + Budget (P2) ──────────────────────────────────────────────

model MealPlan {
  id          String   @id @default(cuid())
  userId      String
  name        String   @default("Ma semaine")
  weekOf      DateTime? // optional Monday of the planned week
  budgetCents Int?      // target budget for the plan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries     MealPlanEntry[]

  @@index([userId])
}

model MealPlanEntry {
  id        String   @id @default(cuid())
  planId    String
  recipeId  String
  servings  Int      @default(4) // desired servings (scales recipe cost/quantities)
  dayOfWeek Int?     // 0=Mon .. 6=Sun, optional
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  plan      MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([recipeId])
}

// ─── Stores ───────────────────────────────────────────────────────────────────

model Store {
  id           String     @id @default(cuid())
  chain        StoreChain
  externalId   String?    // chain's own store id (e.g. IGA "8253")
  name         String
  address      String?
  city         String?
  postalCode   String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  storeProducts StoreProduct[]
  flyerItems    FlyerItem[]

  @@unique([chain, name])
  @@unique([chain, externalId])
  @@index([chain])
  @@index([city])
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id              String     @id @default(cuid())
  name            String
  brand           String?
  category        String
  gtin            String?    @unique
  defaultUnit     String     // g | ml | unit
  defaultUnitType UnitType
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  storeProducts     StoreProduct[]
  ingredients       Ingredient[]
  flyerItems        FlyerItem[]
  unitConversions   UnitConversion[]
  shoppingListItems ShoppingListItem[]

  @@unique([name])
  @@index([category])
  @@index([gtin])
}

model StoreProduct {
  id           String   @id @default(cuid())
  productId    String
  storeId      String
  sku          String?
  packageSize  Float
  packageUnit  String
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  prices       Price[]

  @@unique([productId, storeId, sku])
  @@index([productId])
  @@index([storeId])
}

// ─── Full store catalog (crawled) ──────────────────────────────────────────────
// Independent of curated Product — raw catalog of every scraped store item.
// Recipe ingredients are matched against this by fuzzy/trigram search.

model CatalogItem {
  id          String     @id @default(cuid())
  chain       StoreChain
  name        String
  brand       String?
  category    String?
  priceCents  Int
  packageSize Float      @default(1)
  packageUnit String     @default("unit")
  sourceSku   String?
  url         String?
  inStock     Boolean    @default(true)
  capturedAt  DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([chain, sourceSku])
  @@index([chain])
  @@index([category])
  @@index([name])
}

// ─── Prices ───────────────────────────────────────────────────────────────────

model Price {
  id             String      @id @default(cuid())
  storeProductId String
  priceCents     Int
  currency       String      @default("CAD")
  source         PriceSource
  capturedAt     DateTime    @default(now())
  validFrom      DateTime?
  validTo        DateTime?

  storeProduct   StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)

  @@index([storeProductId])
  @@index([capturedAt])
  @@index([validFrom, validTo])
}

// ─── Flyers ───────────────────────────────────────────────────────────────────

model FlyerItem {
  id                String   @id @default(cuid())
  storeId           String
  productId         String?
  rawText           String
  promoPriceCents   Int
  regularPriceCents Int?
  weekOf            DateTime // Monday of the flyer week
  createdAt         DateTime @default(now())

  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([productId])
  @@index([weekOf])
}

// ─── Recipes ──────────────────────────────────────────────────────────────────

model Recipe {
  id               String   @id @default(cuid())
  sourceUrl        String?  @unique
  title            String
  category         String?  // Déjeuner | Entrée | Plat principal | Dessert | Pâtisserie | Accompagnement
  difficulty       String?  // débutant | confirmé | expert
  servings         Int      @default(4)
  imageUrl         String?
  description      String?
  instructions     String[] // array of steps
  prepTimeMinutes  Int?
  cookTimeMinutes  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ingredients      Ingredient[]
  mealPlanEntries  MealPlanEntry[]

  @@index([title])
  @@index([category])
  @@index([difficulty])
}

model Ingredient {
  id              String   @id @default(cuid())
  recipeId        String
  rawText         String
  parsedQuantity  Float?
  parsedUnit      String?
  productId       String?
  notes           String?
  sortOrder       Int      @default(0)

  recipe          Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([productId])
}

// ─── Unit Conversions ─────────────────────────────────────────────────────────

model UnitConversion {
  id        String   @id @default(cuid())
  fromUnit  String
  toUnit    String
  productId String?  // null = universal, set = product-specific density
  factor    Float    // toUnit = fromUnit * factor

  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([fromUnit, toUnit, productId])
  @@index([fromUnit])
  @@index([toUnit])
  @@index([productId])
}
